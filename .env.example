# Copy these into Vercel → Project → Settings → Environment Variables.

# From Supabase → Project Settings → API:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never put this in the browser or in Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From console.anthropic.com → API keys. Server only. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=sk-ant-...

# Product name on the sign-in screen and admin console
APP_NAME=Orzio
# Links shown at sign-up ("By creating an account you agree to…"). Leave empty until the pages exist.
TERMS_URL=/site/terms
PRIVACY_URL=/site/privacy

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5
# Rate and quota limits live in the database: edit them in /admin (Settings and Plans).

# Optional: Google Maps browser key for office locations (restrict to your domain)
GOOGLE_MAPS_API_KEY=
# Optional: send quotes, agreements, RFQs and reminders by email (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Orzio <billing@yourdomain.com>
# Daily payment reminders (Vercel Cron sends this as a bearer token)
CRON_SECRET=change-me-to-a-long-random-string
APP_URL=https://app.yourdomain.com
# Optional: UAE Local Terrorist List as a CSV you host (otherwise upload it in the app)
UAE_LOCAL_LIST_URL=
# Optional: LSEG World-Check One (paid)
WC1_API_KEY=
WC1_API_SECRET=
WC1_GROUP_ID=

# Custom domains for customers (optional): lets workspace owners add their own domain from Settings
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Website contact form (/site/contact): where messages are sent. Uses RESEND_API_KEY above.
# Empty = the support email set in /admin → Settings.
CONTACT_EMAIL=
